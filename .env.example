# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Business Profile OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Places API (New)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_STARTER_PRICE_ID=price_placeholder_starter
STRIPE_PRO_PRICE_ID=price_placeholder_pro

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# Twilio (optional SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Cron Secret (required for cron job authentication)
CRON_SECRET=your-cron-secret

# AI Budget (optional — default 1000 generations/day)
AI_DAILY_GENERATION_LIMIT=1000

# Encryption (AES-256-GCM for OAuth token encryption at rest)
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-character-encryption-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
